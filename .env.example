# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_group_chat_id_here

# Schedule Times (BRT - UTC-3)
SCHEDULE_TIMES=09:00,14:00,17:00,19:00
TIMEZONE=America/Sao_Paulo

# Dashboard
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=5000
DASHBOARD_SECRET_KEY=change-this-secret-key

# API Key (para proteger os webhooks)
API_KEY=change-this-api-key

# Alert Thresholds
ALERT_THRESHOLD_ABOVE=3.0
ALERT_THRESHOLD_BELOW=3.0

# Scraping
HEADLESS_BROWSER=true
SCRAPE_TIMEOUT=30000
